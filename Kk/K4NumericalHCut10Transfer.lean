import Kk.K4Cut10Continuation
import Kk.K4NumericalHB3Transfer
import Mathlib.Tactic

/-!
# Transfer the first K4 gadget's mixed B3 age witness to the real H

The checked finite continuation at cut 10 has upper vertices
q2 (one copy) and x (two copies). Here we identify its full
initial L socle, complete directed q2 upper type and complete
directed selected-x upper type with the *literal* numerical H
model generated by the four-original K4-free base.

The first 11 old numerical H coordinates are edgeless, both
q2's cut-10 incidences and x's even-old incidences agree with
the concrete witness, and every unary/diagonal/loop atom is
handled explicitly. Thus the corrected finite CommonSocleAgeTest
really fails for these TWO ACTUAL H upper L-types.

This is a genuine L-age obstruction but it does not by itself
prove that both upper types are members of the *full
parameter-closed Algorithm 5.4 source*. That is the next bridge
via the selected cut-22 and q2-parameter closure theorems.
-/

namespace Kk

open SuccessorTree.V10

/-- Below the first reserved original at address 10 there are
no numerical-H edges, including edges to fake odd coordinates. -/
theorem k4H_cut10_old_binary_false
    (x y : Nat) (hx : x ≤ 10) (hy : y ≤ 10) :
    (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
      4 40).binary x y (0 : Fin 1) = false := by
  rw [k4H_old_binary_eq x y (by omega) (by omega)]
  have hx22 : x ≠ 22 := by omega
  have hy22 : y ≠ 22 := by omega
  simp [hx22,hy22]

/-- Q2 at address 22 has exactly one L-neighbour in the old
first-cut socle, namely q1 at address 10. -/
theorem k4H_cut10_q2_incoming_eq (x : Nat) (hx : x ≤ 10) :
    (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
      4 40).binary x 22 (0 : Fin 1) =
      decide (x = 10) := by
  rw [k4H_old_binary_eq x 22 (by omega) (by decide)]
  have hx22 : x ≠ 22 := by omega
  simp [hx22]

theorem k4H_cut10_q2_outgoing_eq (x : Nat) (hx : x ≤ 10) :
    (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
      4 40).binary 22 x (0 : Fin 1) =
      decide (x = 10) := by
  rw [k4H_old_binary_eq 22 x (by decide) (by omega)]
  have hx22 : x ≠ 22 := by omega
  simp [hx22]

/-- There is no numerical-H binary loop at the second reserved
original 22: its L-pair generators require different blocks. -/
theorem k4H_q2_binary_loop_false :
    (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
      4 40).binary 22 22 (0 : Fin 1) = false := by
  change hNumericBinary (normalizedGraphModel k4FourOriginalEdge).binary
      4 22 22 (0 : Fin 1) = false
  by_cases ht : hNumericBinary
      (normalizedGraphModel k4FourOriginalEdge).binary
      4 22 22 (0 : Fin 1) = true
  · obtain ⟨i,j,q,m,hij,hq,_hm,_hgate,hdir⟩ :=
      (hNumericBinary_true_iff
        (normalizedGraphModel k4FourOriginalEdge).binary
        4 22 22 (0 : Fin 1)).1 ht
    have hStrict := hPosition_lt_of_block_lt 4 i j q m hq hij
    rcases hdir with ⟨h1,h2,_⟩ | ⟨h1,h2,_⟩ <;> omega
  · cases hb : hNumericBinary
        (normalizedGraphModel k4FourOriginalEdge).binary
        4 22 22 (0 : Fin 1) with
    | false => rfl
    | true => exact False.elim (ht hb)

/-- FULL initial L-socle equality, including all negative
directed bits, unary/diagonal bits and fake odd coordinates. -/
theorem k4H_cut10_full_old_L_socle :
    SameInitialL k4Cut10Continuation
      (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
        4 40) 10 := by
  refine ⟨?_,?_,?_,?_⟩
  · intro x hx
    change (x < 14 ↔ x < 40)
    omega
  · intro x y hx hy t
    fin_cases t
    change k4Cut10Continuation.binary x y (0 : Fin 1) =
      (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
        4 40).binary x y (0 : Fin 1)
    have hW : k4Cut10Continuation.binary x y (0 : Fin 1) = false := by
      simp [k4Cut10Continuation,hx,hy]
    rw [hW]
    exact (k4H_cut10_old_binary_false x y hx hy).symm
  · intro x hx t
    exact Fin.elim0 t
  · intro x hx t
    fin_cases t
    change false = (finiteNumericHL
      (normalizedGraphModel k4FourOriginalEdge)
      4 40).diagonal x (0 : Fin 1)
    exact (k4H_all_diagonals_false x).symm

/-- The second auxiliary q2 complete upper type at the first
cut is copied from the ACTUAL H original 22, not inferred from
one positive adjacency alone. -/
theorem k4H_cut10_full_q2_upper_type :
    k4Cut10UpperQ2 =
      RelationalPrefixType.ofAgeModel
        (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
          4 40) 11 22 := by
  apply RelationalPrefixType.eq_of_atoms
  · intro a b t
    fin_cases t
    cases a with
    | none =>
      cases b with
      | none =>
        change k4Cut10Continuation.binary 11 11 (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary 22 22 (0 : Fin 1)
        simpa [k4Cut10Continuation] using k4H_q2_binary_loop_false.symm
      | some j =>
        have hj : j.val ≤ 10 := by omega
        change k4Cut10Continuation.binary 11 j.val (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary 22 j.val (0 : Fin 1)
        calc
          k4Cut10Continuation.binary 11 j.val (0 : Fin 1) =
              decide (j.val = 10) := by
            simp [k4Cut10Continuation,hj]
          _ = (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
              4 40).binary 22 j.val (0 : Fin 1) :=
            (k4H_cut10_q2_outgoing_eq j.val hj).symm
    | some i =>
      cases b with
      | none =>
        have hi : i.val ≤ 10 := by omega
        change k4Cut10Continuation.binary i.val 11 (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary i.val 22 (0 : Fin 1)
        calc
          k4Cut10Continuation.binary i.val 11 (0 : Fin 1) =
              decide (i.val = 10) := by
            simp [k4Cut10Continuation,hi]
          _ = (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
              4 40).binary i.val 22 (0 : Fin 1) :=
            (k4H_cut10_q2_incoming_eq i.val hi).symm
      | some j =>
        have hi : i.val ≤ 10 := by omega
        have hj : j.val ≤ 10 := by omega
        change k4Cut10Continuation.binary i.val j.val (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary i.val j.val (0 : Fin 1)
        exact k4H_cut10_full_old_L_socle.2.1 i.val j.val hi hj (0 : Fin 1)
  · intro a t
    exact Fin.elim0 t
  · intro a t
    fin_cases t
    cases a with
    | none =>
      change k4Cut10Continuation.diagonal 11 (0 : Fin 1) =
        (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
          4 40).diagonal 22 (0 : Fin 1)
      exact (k4H_all_diagonals_false 22).symm
    | some i =>
      change k4Cut10Continuation.diagonal i.val (0 : Fin 1) =
        (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
          4 40).diagonal i.val (0 : Fin 1)
      exact (k4H_all_diagonals_false i.val).symm

/-- The selected top original x complete prefix through cut 10. -/
theorem k4H_cut10_full_x_upper_type :
    k4Cut10UpperX =
      RelationalPrefixType.ofAgeModel
        (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
          4 40) 11 38 := by
  apply RelationalPrefixType.eq_of_atoms
  · intro a b t
    fin_cases t
    cases a with
    | none =>
      cases b with
      | none =>
        change k4Cut10Continuation.binary 12 12 (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary 38 38 (0 : Fin 1)
        simpa [k4Cut10Continuation] using
          k4H_top_binary_loop_false.symm
      | some j =>
        have hj : j.val ≤ 10 := by omega
        change k4Cut10Continuation.binary 12 j.val (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary 38 j.val (0 : Fin 1)
        calc
          k4Cut10Continuation.binary 12 j.val (0 : Fin 1) =
              decide (j.val % 2 = 0) := by
            simp [k4Cut10Continuation,hj]
          _ = (finiteNumericHL
              (normalizedGraphModel k4FourOriginalEdge)
              4 40).binary 38 j.val (0 : Fin 1) :=
            (k4H_upper_edge_reverse_eq j.val (by omega)).symm
    | some i =>
      cases b with
      | none =>
        have hi : i.val ≤ 10 := by omega
        change k4Cut10Continuation.binary i.val 12 (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary i.val 38 (0 : Fin 1)
        calc
          k4Cut10Continuation.binary i.val 12 (0 : Fin 1) =
              decide (i.val % 2 = 0) := by
            simp [k4Cut10Continuation,hi]
          _ = (finiteNumericHL
              (normalizedGraphModel k4FourOriginalEdge)
              4 40).binary i.val 38 (0 : Fin 1) :=
            (k4H_upper_edge_eq i.val (by omega)).symm
      | some j =>
        have hi : i.val ≤ 10 := by omega
        have hj : j.val ≤ 10 := by omega
        change k4Cut10Continuation.binary i.val j.val (0 : Fin 1) =
          (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
            4 40).binary i.val j.val (0 : Fin 1)
        exact k4H_cut10_full_old_L_socle.2.1 i.val j.val hi hj (0 : Fin 1)
  · intro a t
    exact Fin.elim0 t
  · intro a t
    fin_cases t
    cases a with
    | none =>
      change k4Cut10Continuation.diagonal 12 (0 : Fin 1) =
        (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
          4 40).diagonal 38 (0 : Fin 1)
      exact (k4H_all_diagonals_false 38).symm
    | some i =>
      change k4Cut10Continuation.diagonal i.val (0 : Fin 1) =
        (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
          4 40).diagonal i.val (0 : Fin 1)
      exact (k4H_all_diagonals_false i.val).symm

/-- Initial socle from q2's genuine complete extracted type. -/
theorem k4H_cut10_prescribed_socle :
    SameInitialL k4Cut10Continuation
      (prescribedOrdinarySocle
        ((finiteNumericH (normalizedGraphModel k4FourOriginalEdge)
          4 40).partialTypeAt 11 22)) 10 := by
  let A := finiteNumericH (normalizedGraphModel k4FourOriginalEdge) 4 40
  have hToAmbient : SameInitialL k4Cut10Continuation A.L 10 :=
    k4H_cut10_full_old_L_socle
  have hFromType :
      SameInitialL
        (prescribedOrdinarySocle (A.partialTypeAt 11 22))
        A.L 10 :=
    ambient_partialType_prescribedSocle A 10 22 (by decide)
  have hReverse :
      SameInitialL A.L
        (prescribedOrdinarySocle (A.partialTypeAt 11 22)) 10 := by
    refine ⟨?_,?_,?_,?_⟩
    · intro x hx
      exact (hFromType.1 x hx).symm
    · intro x y hx hy t
      exact (hFromType.2.1 x y hx hy t).symm
    · intro x hx t
      exact (hFromType.2.2.1 x hx t).symm
    · intro x hx t
      exact (hFromType.2.2.2 x hx t).symm
  exact hToAmbient.trans hReverse

/-- The full corrected-B3 test really fails at numerical H cut 10
when its permitted complete upper L-types include q2=22 and x=38.
This is independent of any abstract selected graph-age shadow.

Whether the actual parameter-closed stage contains BOTH types
is addressed by the separate AlgorithmRun q2-closure theorem.
-/
theorem k4H_actual_cut10_twoUpper_B3_failure :
    ¬ CommonSocleAgeTest
      (hensonForbiddenFamily 4 (by decide))
      (prescribedOrdinarySocle
        ((finiteNumericH (normalizedGraphModel k4FourOriginalEdge)
          4 40).partialTypeAt 11 22)) 10
      (fun R =>
        R = ((finiteNumericH (normalizedGraphModel k4FourOriginalEdge)
          4 40).partialTypeAt 11 22).lReduct ∨
        R = ((finiteNumericH (normalizedGraphModel k4FourOriginalEdge)
          4 40).partialTypeAt 11 38).lReduct) := by
  intro hB3
  have hUpperActual :
      UpperTypesPrescribed k4Cut10Continuation 10
        (fun R =>
          R = ((finiteNumericH (normalizedGraphModel k4FourOriginalEdge)
            4 40).partialTypeAt 11 22).lReduct ∨
          R = ((finiteNumericH (normalizedGraphModel k4FourOriginalEdge)
            4 40).partialTypeAt 11 38).lReduct) := by
    intro x hx hAbove
    obtain hQ | hX := k4Cut10_upper_types x hx hAbove
    · exact Or.inl (hQ.trans k4H_cut10_full_q2_upper_type)
    · exact Or.inr (hX.trans k4H_cut10_full_x_upper_type)
  have hK4mem :
      (NormalizedForbidden.nontrivial 4
        (cliquePattern 4) (by decide) (cliquePattern_irreducible 4)) ∈
        hensonForbiddenFamily 4 (by decide) := by
    simp [hensonForbiddenFamily]
  have hAvoid := hB3
    k4Cut10Continuation k4Cut10_finite
    k4H_cut10_prescribed_socle hUpperActual
    k4Cut10_deleted_avoids
    (NormalizedForbidden.nontrivial 4
      (cliquePattern 4) (by decide) (cliquePattern_irreducible 4))
    hK4mem
  exact hAvoid k4Cut10_realizesK4

end Kk
