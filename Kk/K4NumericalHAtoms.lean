import Kk.K4Cut22Continuation
import Kk.HensonZeroGenerationClique
import SuccessorTree.V10.HFinitePartial
import Mathlib.Tactic

/-!
# Literal numerical H atom calculation for the K4 two-cut example

The four-original K4-free base has edges p--x, q1--q2, q1--x
and q2--x; order its vertices p=0, q1=1, q2=2, x=3.

At numerical height k=4, the finite H L-reduct on coordinates
0,...,22 has precisely one edge (10,22), and the top
original x at 38 is adjacent to every even coordinate through 22
(and to no odd one). Both statements quantify over ALL old
coordinates, including odd fake vertices.

These are the atomic comparison obligations needed to transfer
the explicit sparse 25-vertex corrected-B3 continuation to the
actual finiteNumericH generated by this base graph.
-/

namespace Kk

open SuccessorTree.V10

/-- Exact four-original base graph: star with centre 3, plus 1--2. -/
def k4FourOriginalEdge (i j : Nat) : Bool :=
  decide ((i = 1 ∧ j = 2) ∨ (i = 2 ∧ j = 1) ∨
    (i = 3 ∧ j < 3) ∨ (j = 3 ∧ i < 3))

theorem k4FourOriginalEdge_symmetric (i j : Nat) :
    k4FourOriginalEdge i j = k4FourOriginalEdge j i := by
  unfold k4FourOriginalEdge
  have hP :
      ((i = 1 ∧ j = 2) ∨ (i = 2 ∧ j = 1) ∨
        (i = 3 ∧ j < 3) ∨ (j = 3 ∧ i < 3)) ↔
      ((j = 1 ∧ i = 2) ∨ (j = 2 ∧ i = 1) ∨
        (j = 3 ∧ i < 3) ∨ (i = 3 ∧ j < 3)) := by
    tauto
  by_cases hp : ((i = 1 ∧ j = 2) ∨ (i = 2 ∧ j = 1) ∨
      (i = 3 ∧ j < 3) ∨ (j = 3 ∧ i < 3))
  · have hq := hP.mp hp
    simp [hp,hq]
  · have hq : ¬ ((j = 1 ∧ i = 2) ∨ (j = 2 ∧ i = 1) ∨
        (j = 3 ∧ i < 3) ∨ (i = 3 ∧ j < 3)) := by
      intro h
      exact hp (hP.mpr h)
    simp [hp,hq]

theorem k4FourOriginalEdge_irreflexive (i : Nat) :
    k4FourOriginalEdge i i = false := by
  simp [k4FourOriginalEdge]
  omega

theorem k4FourOriginalEdge_cliqueFree :
    ¬ ∃ f : Fin 4 → Nat, StrictMono f ∧
      ∀ a b : Fin 4, a ≠ b →
        k4FourOriginalEdge (f a) (f b) = true := by
  rintro ⟨f,hMono,hEdges⟩
  have h01 : f 0 < f 1 := hMono (by decide)
  have h12 : f 1 < f 2 := hMono (by decide)
  have h23 : f 2 < f 3 := hMono (by decide)
  have hEdge := hEdges (2 : Fin 4) (3 : Fin 4) (by decide)
  have hLast : f 3 ≤ 3 := by
    simp only [k4FourOriginalEdge, decide_eq_true_eq] at hEdge
    omega
  have hf0 : f 0 = 0 := by omega
  have hf1 : f 1 = 1 := by omega
  have hContr := hEdges (0 : Fin 4) (1 : Fin 4) (by decide)
  rw [hf0,hf1] at hContr
  norm_num [k4FourOriginalEdge] at hContr

/-- Every positive old--old edge in exact numerical H through
coordinate 22 is the edge 10--22, in one of its orientations. -/
theorem k4H_old_binary_true_iff
    (x y : Nat) (hx : x ≤ 22) (hy : y ≤ 22) :
    hNumericBinary (normalizedGraphModel k4FourOriginalEdge).binary
        4 x y (0 : Fin 1) = true ↔
      ((x = 10 ∧ y = 22) ∨ (x = 22 ∧ y = 10)) := by
  rw [hNumericBinary_true_iff]
  constructor
  · rintro ⟨i,j,q,m,hij,hq,hm,hgate,hdir⟩
    rcases hdir with ⟨hX,hY,hBit⟩ | ⟨hX,hY,hBit⟩
    · have hHigh : hPosition 4 j m ≤ 22 := by omega
      have hj : j ≤ 2 := by
        dsimp [hPosition] at hHigh
        omega
      have hBase : (i = 1 ∧ j = 2) ∨ (i = 2 ∧ j = 1) ∨
          (i = 3 ∧ j < 3) ∨ (j = 3 ∧ i < 3) := by
        simpa only [normalizedGraphModel, binaryUnaryAgeModel,
          k4FourOriginalEdge, decide_eq_true_eq] using hBit
      have hIJ : i = 1 ∧ j = 2 := by omega
      rcases hIJ with ⟨rfl,rfl⟩
      have hmSmall : m ≤ 1 := by
        dsimp [hPosition] at hHigh
        omega
      have hQM : q = 0 ∧ m = 1 := by
        rcases hgate with hgate | ⟨hSame,hTop⟩ <;> omega
      rcases hQM with ⟨rfl,rfl⟩
      exact Or.inl ⟨by simpa [hPosition] using hX,
        by simpa [hPosition] using hY⟩
    · have hHigh : hPosition 4 j m ≤ 22 := by omega
      have hj : j ≤ 2 := by
        dsimp [hPosition] at hHigh
        omega
      have hBase : (j = 1 ∧ i = 2) ∨ (j = 2 ∧ i = 1) ∨
          (j = 3 ∧ i < 3) ∨ (i = 3 ∧ j < 3) := by
        simpa only [normalizedGraphModel, binaryUnaryAgeModel,
          k4FourOriginalEdge, decide_eq_true_eq] using hBit
      have hIJ : i = 1 ∧ j = 2 := by omega
      rcases hIJ with ⟨rfl,rfl⟩
      have hmSmall : m ≤ 1 := by
        dsimp [hPosition] at hHigh
        omega
      have hQM : q = 0 ∧ m = 1 := by
        rcases hgate with hgate | ⟨hSame,hTop⟩ <;> omega
      rcases hQM with ⟨rfl,rfl⟩
      exact Or.inr ⟨by simpa [hPosition] using hX,
        by simpa [hPosition] using hY⟩
  · rintro (⟨rfl,rfl⟩ | ⟨rfl,rfl⟩)
    · refine ⟨1,2,0,1,by omega,by omega,by omega,
        Or.inl (by omega),Or.inl ⟨by decide,by decide,?_⟩⟩
      change k4FourOriginalEdge 1 2 = true
      decide
    · refine ⟨1,2,0,1,by omega,by omega,by omega,
        Or.inl (by omega),Or.inr ⟨by decide,by decide,?_⟩⟩
      change k4FourOriginalEdge 2 1 = true
      decide

/-- Boolean form of the literal first-socle edge classification. -/
theorem k4H_old_binary_eq
    (x y : Nat) (hx : x ≤ 22) (hy : y ≤ 22) :
    (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
      4 40).binary x y (0 : Fin 1) =
      decide ((x = 10 ∧ y = 22) ∨ (x = 22 ∧ y = 10)) := by
  have hh := k4H_old_binary_true_iff x y hx hy
  by_cases hp : (x = 10 ∧ y = 22) ∨ (x = 22 ∧ y = 10)
  · have ht : (finiteNumericHL
      (normalizedGraphModel k4FourOriginalEdge) 4 40).binary x y
        (0 : Fin 1) = true := hh.2 hp
    simp [hp,ht]
  · have hf : (finiteNumericHL
      (normalizedGraphModel k4FourOriginalEdge) 4 40).binary x y
        (0 : Fin 1) = false := by
      cases hb : (finiteNumericHL
        (normalizedGraphModel k4FourOriginalEdge) 4 40).binary x y
          (0 : Fin 1) with
      | false => rfl
      | true => exact False.elim (hp (hh.1 hb))
    simp [hp,hf]

/-- Every old H vertex with a positive edge to the top
original 38 is EVEN, fake odd addresses never contribute. -/
theorem k4H_upper_edge_true_iff
    (x : Nat) (hx : x ≤ 22) :
    hNumericBinary (normalizedGraphModel k4FourOriginalEdge).binary
        4 x 38 (0 : Fin 1) = true ↔ x % 2 = 0 := by
  rw [hNumericBinary_true_iff]
  constructor
  · rintro ⟨i,j,q,m,_hij,_hq,_hm,_hgate,hdir⟩
    rcases hdir with ⟨hX,_,_⟩ | ⟨hX,_,_⟩
    · obtain ⟨v,hEven⟩ := hPosition_even 4 i q
      omega
    · obtain ⟨v,hEven⟩ := hPosition_even 4 j m
      omega
  · intro hEven
    let i := x / 10
    let q := (x % 10) / 2
    have hi : i < 3 := by dsimp [i]; omega
    have hq : q ≤ 4 := by dsimp [q]; omega
    have hPositionEq : x = hPosition 4 i q := by
      dsimp [i,q,hPosition]
      omega
    have hBase : (normalizedGraphModel k4FourOriginalEdge).binary
        i 3 (0 : Fin 1) = true := by
      change k4FourOriginalEdge i 3 = true
      simp [k4FourOriginalEdge]
      omega
    have hGate : q < 4 ∨ (q = 4 ∧ 4 = 4) := by
      by_cases hq4 : q = 4
      · exact Or.inr ⟨hq4,rfl⟩
      · exact Or.inl (by omega)
    refine ⟨i,3,q,4,hi,hq,by omega,hGate,
      Or.inl ⟨hPositionEq,by decide,hBase⟩⟩

theorem k4H_upper_edge_eq
    (x : Nat) (hx : x ≤ 22) :
    (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
      4 40).binary x 38 (0 : Fin 1) =
      decide (x % 2 = 0) := by
  have hh := k4H_upper_edge_true_iff x hx
  by_cases hp : x % 2 = 0
  · have ht : (finiteNumericHL
      (normalizedGraphModel k4FourOriginalEdge) 4 40).binary
      x 38 (0 : Fin 1) = true := hh.2 hp
    simp [hp,ht]
  · have hf : (finiteNumericHL
      (normalizedGraphModel k4FourOriginalEdge) 4 40).binary
      x 38 (0 : Fin 1) = false := by
      cases hb : (finiteNumericHL
        (normalizedGraphModel k4FourOriginalEdge) 4 40).binary
          x 38 (0 : Fin 1) with
      | false => rfl
      | true => exact False.elim (hp (hh.1 hb))
    simp [hp,hf]

/-- The symmetric base graph makes the reverse original--old
edge equal, with no loss of negative directed information. -/
theorem k4H_upper_edge_reverse_eq
    (x : Nat) (hx : x ≤ 22) :
    (finiteNumericHL (normalizedGraphModel k4FourOriginalEdge)
      4 40).binary 38 x (0 : Fin 1) =
      decide (x % 2 = 0) := by
  have hSym : ∀ i j t,
      (normalizedGraphModel k4FourOriginalEdge).binary i j t =
        (normalizedGraphModel k4FourOriginalEdge).binary j i t := by
    intro i j t
    fin_cases t
    change k4FourOriginalEdge i j = k4FourOriginalEdge j i
    exact k4FourOriginalEdge_symmetric i j
  exact (hNumericBinary_symmetric_of_base
    (normalizedGraphModel k4FourOriginalEdge).binary hSym
      4 38 x (0 : Fin 1)).trans (k4H_upper_edge_eq x hx)

end Kk
